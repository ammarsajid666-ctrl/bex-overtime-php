<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the PHP portal. Requires PHP 8.3 (NTS, x64) installed with FastCGI.
  Set scriptProcessor to the php-cgi.exe path on this server (for example C:\PHP\php-cgi.exe).
  The site's physical path must point at this public folder, not the project root.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <handlers>
      <add name="PHP-FastCGI" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
</configuration>
